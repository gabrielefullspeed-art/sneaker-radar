# ============================================================
#  CHIAVI — copia questo file rinominandolo in  .env
#  e incolla i valori dopo il segno =
#
#  Il file .env resta SOLO sul tuo PC: e' escluso da .gitignore
#  e non finira' mai su GitHub.
# ============================================================

# --- Telegram: OBBLIGATORIO -------------------------------------------
# Da @BotFather su Telegram: /newbot
TELEGRAM_BOT_TOKEN=

# Non cercarlo a mano: lascia vuoto, scrivi un messaggio al tuo bot
# e lancia  python -m sneakers.run setup  che te lo dice lui.
TELEGRAM_CHAT_ID=

# --- Telegram: canali separati (facoltativi) ---------------------------
# Se li lasci vuoti, grail e sospetti arrivano nella chat principale.
TELEGRAM_CHAT_ID_GRAILS=
TELEGRAM_CHAT_ID_SUSPICIOUS=

# --- eBay: la sorgente piu' importante ---------------------------------
# developer.ebay.com -> crea un'app Production
# App ID (Client ID) e Cert ID (Client Secret)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# --- KicksDB: prezzi di riferimento StockX/GOAT (facoltativo) ----------
# kicks.dev -> registrazione gratuita, nessuna carta
# Senza questa chiave il sistema funziona lo stesso, ma impiega
# qualche settimana a capire da solo i prezzi normali.
KICKSDB_API_KEY=
